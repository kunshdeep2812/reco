<div class="d-flex justify-content-between align-items-center mb-2">
  <h1>Scan #<%= @scan.id %> <span id="scan-status" class="badge badge-status-<%= @scan.status %>"><%= @scan.status %></span></h1>
  <a class="btn btn-outline-light btn-sm" href="/scans/<%= @scan.id %>/findings.csv">Export findings CSV</a>
</div>
<p class="text-muted">Target: <strong><%= h(@scan.target.name) %></strong> &middot; Engine: <strong><%= h(@scan.engine.name) %></strong></p>

<div class="row">
  <div class="col-md-6">
    <h5>Stages</h5>
    <table class="table table-sm">
      <thead><tr><th>Stage</th><th>Tool</th><th>Host</th><th>Status</th></tr></thead>
      <tbody id="task-table">
        <% @tasks.each do |t| %>
          <tr id="task-row-<%= t.id %>">
            <td><%= h(t.stage_name) %></td>
            <td><code><%= h(t.tool) %></code></td>
            <td><%= t.host ? h(t.host.name) : 'local' %></td>
            <td><span id="task-status-<%= t.id %>" class="badge badge-status-<%= t.status %>"><%= t.status %></span></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <h5>Findings <span id="findings-count" class="badge bg-secondary"><%= @findings.count %></span></h5>
    <table class="table table-sm">
      <thead><tr><th>Kind</th><th>Value</th></tr></thead>
      <tbody id="findings-table">
        <% @findings.each do |f| %>
          <tr><td><%= h(f.kind) %></td><td><%= h(f.value) %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="col-md-6">
    <h5>Live output</h5>
    <pre class="log" id="live-log"><% @tasks.each { |t| %><%= h(t.output) %><% } %></pre>
  </div>
</div>

<script>
(function() {
  var scanId = <%= @scan.id %>;
  var log = document.getElementById('live-log');
  var scanStatus = document.getElementById('scan-status');
  var taskTable = document.getElementById('task-table');
  var findingsTable = document.getElementById('findings-table');
  var findingsCount = document.getElementById('findings-count');
  var count = <%= @findings.count %>;

  function setBadge(el, status) {
    el.textContent = status;
    el.className = 'badge badge-status-' + status;
  }

  function appendLog(line) {
    log.textContent += line + "\n";
    log.scrollTop = log.scrollHeight;
  }

  if (!!window.EventSource && '<%= @scan.status %>' !== 'completed' && '<%= @scan.status %>' !== 'failed') {
    var es = new EventSource('/scans/' + scanId + '/stream');
    es.onmessage = function(evt) {
      var data = JSON.parse(evt.data);
      if (data.type === 'scan_status') {
        setBadge(scanStatus, data.status);
        if (data.status === 'completed' || data.status === 'failed') es.close();
      } else if (data.type === 'task') {
        var row = document.getElementById('task-row-' + data.task.id);
        if (!row) {
          row = document.createElement('tr');
          row.id = 'task-row-' + data.task.id;
          var tdStage = document.createElement('td'); tdStage.textContent = data.task.stage_name;
          var tdTool = document.createElement('td'); var code = document.createElement('code'); code.textContent = data.task.tool; tdTool.appendChild(code);
          var tdHost = document.createElement('td'); tdHost.textContent = data.task.host_id || 'local';
          var tdStatus = document.createElement('td'); var badge = document.createElement('span');
          badge.id = 'task-status-' + data.task.id;
          badge.className = 'badge badge-status-' + data.task.status;
          badge.textContent = data.task.status;
          tdStatus.appendChild(badge);
          row.appendChild(tdStage); row.appendChild(tdTool); row.appendChild(tdHost); row.appendChild(tdStatus);
          taskTable.appendChild(row);
        }
      } else if (data.type === 'task_update') {
        var badge2 = document.getElementById('task-status-' + data.task.id);
        if (badge2) setBadge(badge2, data.task.status);
      } else if (data.type === 'output') {
        appendLog(data.line);
      } else if (data.type === 'finding') {
        var tr = document.createElement('tr');
        var tdKind = document.createElement('td'); tdKind.textContent = data.finding.kind;
        var tdValue = document.createElement('td'); tdValue.textContent = data.finding.value;
        tr.appendChild(tdKind); tr.appendChild(tdValue);
        findingsTable.appendChild(tr);
        count += 1;
        findingsCount.textContent = count;
      }
    };
  }
})();
</script>
